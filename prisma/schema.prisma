generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum NotesView {
  card
  list
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userName     String    @unique
  password     String
  name         String
  profileImage String?
  notes        Note[]
  notesView    NotesView @default(card)
  createdAt    DateTime  @default(now())
}

model Note {
  noteId    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  noteType  String
  noteName  String
  entries   Entry[]
  noteView  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Entry {
  entryId   String    @id @default(auto()) @map("_id") @db.ObjectId
  noteId    String    @db.ObjectId
  item      String
  priority  String?
  isChecked Boolean?
  category  String?
  createdAt DateTime  @default(now())
  lastEdit  DateTime? @updatedAt
  note      Note      @relation(fields: [noteId], references: [noteId], onDelete: Cascade)

  // Compound index backs both the noteId filter and the createdAt sort
  // used when loading a note's entries (getNoteEntries)
  @@index([noteId, createdAt])
}
